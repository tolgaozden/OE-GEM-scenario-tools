# Model output is licensed content and stays on your machine: keep the configs and
# scripts under version control, not the data, equations or charts they produce.

# Default output and cache folders
outputs/
.oegem_cache/

# Scenario command files can carry baseline-derived levels (solve.resolve: levels)
*.3fs

# Data, catalogues, equations, manifests and reports
*.csv
*.xlsx
*.xls
*.parquet
*.pq
*.json
*.tex
*.dot
*.html

# Charts and documents made from model output
*.png
*.pdf
*.svg

# Credentials never go in files: OE_TOKEN comes from the environment
.env
.env.*
*.token

# Python
__pycache__/
*.py[cod]
.venv/
