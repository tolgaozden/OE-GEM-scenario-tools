#!/bin/sh
# Git pre-commit hook: block commits that would publish credentials or licensed
# model content (equations, coefficients, data, output files).
#
# Install once per clone, from the repository root:
#     git config core.hooksPath tools/hooks
#
# The hook runs `python tools/check_confidential.py --staged`, which scans the
# staged version of every added, copied, modified or renamed file. Set
# OEGEM_PYTHON to choose the interpreter (default: the first working python3,
# python or py). Local deny terms go in .git/info/oegem-deny.txt, which git
# never commits.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

python_ok() {
    "$1" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1
}

PY=${OEGEM_PYTHON:-}
if [ -n "$PY" ] && ! python_ok "$PY"; then
    echo "pre-commit: OEGEM_PYTHON=$PY is not a working Python 3.9 or newer." >&2
    exit 1
fi
if [ -z "$PY" ]; then
    # The python3 found first on Windows may be a store stub, so test each one.
    for candidate in python3 python py; do
        if python_ok "$candidate"; then
            PY=$candidate
            break
        fi
    done
fi
if [ -z "$PY" ]; then
    echo "pre-commit: no Python 3.9 or newer found, so the confidentiality check could not run." >&2
    echo "Install Python or set OEGEM_PYTHON. To commit without the check (deliberately): git commit --no-verify" >&2
    exit 1
fi

if "$PY" tools/check_confidential.py --staged; then
    exit 0
fi

cat >&2 <<'EOF'

Commit blocked by the confidentiality check (tools/check_confidential.py).
  - Remove the flagged content or keep it outside the repository: credentials
    in environment variables, model results under outputs/ (git ignores it).
  - Unstage a file that should not be committed:  git restore --staged <file>
  - A deliberate false positive: add the comment "leakcheck: allow" on that line.
  - Bypass the check for this one commit, only if you are sure:  git commit --no-verify
EOF
exit 1
